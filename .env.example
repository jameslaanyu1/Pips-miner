# PIPS Miner Bot - Environment Configuration Example
# Copy this to .env and fill in your actual credentials

# ============================================
# MetaAPI Configuration (REQUIRED)
# ============================================
# Get these from: https://app.metaapi.cloud/

# Your MetaAPI API Token
# Location: Profile → API Keys → Copy Token
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
METAAPI_TOKEN=your_metaapi_token_here

# Your Account ID from MetaAPI Dashboard
# Location: Accounts → Your Account → Copy ID
# Format: 1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p
METAAPI_ACCOUNT_ID=your_account_id_here

# ============================================
# Trading Configuration
# ============================================
# Symbol to trade (XAUUSD = Gold)
TRADING_SYMBOL=XAUUSD

# Lot size for each trade (0.01 = 1 micro lot)
TRADING_VOLUME=0.01

# Stop loss distance in pips (50 pips = 50 * 0.0001)
STOP_PIPS=50

# ============================================
# Server Configuration
# ============================================
# Flask backend port
PORT=5000

# Flask environment (production or development)
FLASK_ENV=production

# Debug mode (True/False)
DEBUG=False

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Open your MetaAPI Configuration page:
#    https://app.metaapi.cloud/configure-trading-account-credentials/
#
# 2. Copy your Account ID from the URL or dashboard
#    Example: f8a66c52-367f-49cd-8692-7b7c97f33877
#
# 3. Get your API Token:
#    - Click Profile icon (top right)
#    - Select "API Keys"
#    - Copy the token (starts with eyJ...)
#
# 4. Fill in the values above
#
# 5. Save this file as .env in project root
#
# 6. Test connection:
#    python test_metaapi_bridge.py
#
# 7. If test passes, run bot:
#    python metaapi_bot.py
